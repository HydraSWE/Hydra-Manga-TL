## This is an example .env file for configuring the application.
QWEN_MODEL_PATH=models\qwen\Qwen3-4B-Instruct-2507-Q4_K_M.gguf
HYDRA_PIN=change-me
HYDRA_DATA_DIR=./hydra-data
HYDRA_STORAGE_ROOT=./hydra-storage
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
## i have models folder in my project directory, 
## and inside it, I have a subfolder named 'qwen' 
## where the model file 'Qwen3-4B-Instruct-2507-Q4_K_M.gguf' 
## is located. This path is used to specify the location of 
## the model for loading and inference purposes in 
## the application.
